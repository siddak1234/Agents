# -----------------------------------------------------------------------------
# realty-lead-gen — environment configuration
#
# Copy to `.env` for local development. All settings are validated by
# pydantic-settings on startup; missing required values fail fast.
# -----------------------------------------------------------------------------

# --- Runtime ------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_LOG_FORMAT=json                 # json | console

# --- HTTP ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000  # comma-separated, or * for dev only

# --- Database (Postgres 17 + PostGIS 3.5) -------------------------------------
DATABASE_URL=postgresql+asyncpg://rlg:rlg@localhost:5432/rlg
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis (arq queue + cache) ------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT verify only — tokens minted by frontend / Snoopy) --------------
# One of these must be set:
JWT_JWKS_URL=                       # e.g. https://your-idp/.well-known/jwks.json
JWT_HS_SECRET=dev-only-do-not-use   # dev fallback; use JWKS in production
JWT_ISSUER=snoopy
JWT_AUDIENCE=realty-lead-gen

# --- LLM providers ------------------------------------------------------------
ANTHROPIC_API_KEY=                  # required for photo grading + reasoning
ANTHROPIC_MODEL_REASONING=claude-sonnet-4-5
ANTHROPIC_MODEL_VISION=claude-sonnet-4-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
LLM_MAX_COST_PER_LEAD_USD=1.00      # circuit breaker

# --- Data sources — all optional. Adapters no-op when their key is absent. ---
# MLS / RESO
RESO_TRESTLE_TOKEN=
RESO_TRESTLE_BASE_URL=https://api-trestle.corelogic.com
MLS_GRID_TOKEN=

# Portal scraping via Bright Data unlocker
BRIGHT_DATA_ZONE=
BRIGHT_DATA_TOKEN=

# RapidAPI Zillow endpoint (prototype only — brittle, not production)
RAPIDAPI_KEY=
RAPIDAPI_ZILLOW_HOST=zillow-com1.p.rapidapi.com

# Distressed / off-market
PROPERTYRADAR_API_TOKEN=
ATTOM_API_KEY=

# Skip tracing
BATCHSKIPTRACING_API_KEY=

# AVM / rent estimates
RENTCAST_API_KEY=
HOUSECANARY_API_KEY=

# --- Outbox delivery (transactional outbox -> Snoopy) -------------------------
# Leave OUTBOX_WEBHOOK_URL unset to keep the relay draining into the log only.
# When it is set in production the secret is mandatory (HMAC signature over the
# body); startup validation rejects a URL with no secret.
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_SECRET=
OUTBOX_WEBHOOK_TIMEOUT_SECONDS=10.0

# --- Budgets / rate limits ----------------------------------------------------
INGEST_MAX_LISTINGS_PER_RUN=500
ENRICH_MAX_CONCURRENCY=8

# Quota is per authenticated subject (the token's `sub`), enforced with a
# moving window. Counters live in Redis so every API worker shares one budget.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120
# Leave blank to derive from REDIS_URL, which is what any real deployment
# wants. Override only to point at a different Redis, or to `async+memory://`
# for a single-process dev run. Must name an async `limits` backend — a sync
# URI is rejected at startup because it would block the event loop.
API_RATE_LIMIT_STORAGE_URI=
