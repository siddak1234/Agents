# realty-lead-gen — environment template.
#
# Copy to `.env` and fill in what you have. Every variable is optional: a
# missing key disables photo grading (the capability returns `unavailable`),
# it never crashes the agent. `.env` is gitignored; this template is not.
#
# The full service's configuration — database, Redis, JWT, vendor keys —
# lives with the service in the realty-lead-gen-service repository. This
# agent reads only what its capabilities use.

# --- Runtime -----------------------------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
# json in production; console is easier on the eyes locally
APP_LOG_FORMAT=console

# --- LLM ---------------------------------------------------------------------
# Absent: grade_photos returns `unavailable` and describe still answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_VISION=claude-sonnet-4-5
