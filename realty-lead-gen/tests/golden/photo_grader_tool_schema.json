{
  "description": "Record the structured photo condition analysis for a property.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "notes_for_reviewer": {
        "type": "string"
      },
      "overall_condition": {
        "enum": [
          "C1",
          "C2",
          "C3",
          "C4",
          "C5",
          "C6",
          "NEEDS_HUMAN_REVIEW"
        ],
        "type": "string"
      },
      "overall_confidence": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "red_flags": {
        "items": {
          "enum": [
            "foundation",
            "roof",
            "water_damage",
            "mold",
            "fire_damage",
            "structural",
            "none"
          ],
          "type": "string"
        },
        "type": "array"
      },
      "rehab_total_high_usd": {
        "minimum": 0,
        "type": "number"
      },
      "rehab_total_low_usd": {
        "minimum": 0,
        "type": "number"
      },
      "systems": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "condition_grade": {
              "enum": [
                "C1",
                "C2",
                "C3",
                "C4",
                "C5",
                "C6",
                "NOT_VISIBLE"
              ],
              "type": "string"
            },
            "observations": {
              "maxLength": 400,
              "type": "string"
            },
            "repair_items": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "confidence": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "cost_high_usd": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "cost_low_usd": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "evidence_photo_ids": {
                    "items": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "item": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  }
                },
                "required": [
                  "item",
                  "scope",
                  "cost_low_usd",
                  "cost_high_usd",
                  "confidence",
                  "evidence_photo_ids"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "system": {
              "enum": [
                "kitchen",
                "bathrooms",
                "flooring",
                "interior_paint",
                "windows",
                "roof",
                "exterior_siding",
                "hvac_visible",
                "plumbing_visible",
                "electrical_visible",
                "structural",
                "landscaping"
              ],
              "type": "string"
            }
          },
          "required": [
            "system",
            "condition_grade",
            "observations",
            "repair_items"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "overall_condition",
      "overall_confidence",
      "rehab_total_low_usd",
      "rehab_total_high_usd",
      "systems",
      "red_flags"
    ],
    "type": "object"
  },
  "name": "record_photo_analysis"
}