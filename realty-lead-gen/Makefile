# realty-lead-gen — developer tasks
# All targets use `uv` for hermetic Python management. First-time setup: `make setup`.

.PHONY: help setup hooks fmt lint typecheck test test-unit test-integration test-cov \
        migrate migration-new revision-check api worker shell dev-up dev-down \
        clean docker-build

help:  ## show this help
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "  \033[36m%-22s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

# NOT `pre-commit install`. This folder shares one .git with the repository,
# and a git repo holds exactly one pre-commit hook — installing from here
# rewrites it to point at this folder's config, which silently disables every
# root gate (secret scan, lint, both integration checks) for all later
# commits. Proven, not hypothetical. The root config owns the installed hook;
# this folder's hooks run on demand via `make hooks`.
setup:  ## create venv and install all extras
	uv sync --all-extras

hooks:  ## run this folder's pre-commit hooks (does not touch the installed hook)
	uv run pre-commit run --all-files

# `scripts` is in scope everywhere `src` is. It is small, but
# `measure_surface.py` is the thing ARCHITECTURE.md's numbers are derived
# from, so a type error that silently changes what it reports is worse than
# one in application code — nobody would notice.
fmt:  ## format code
	uv run ruff format src tests scripts
	uv run ruff check --fix src tests scripts

lint:  ## static checks (ruff + mypy)
	uv run ruff check src tests scripts
	uv run ruff format --check src tests scripts
	uv run mypy src scripts

typecheck:  ## mypy only
	uv run mypy src scripts

test:  ## run unit tests (fast, no docker)
	uv run pytest -m unit

test-unit: test  ## alias

test-integration:  ## run integration tests (spins up postgres + redis via testcontainers)
	uv run pytest -m integration

test-cov:  ## full test suite with coverage report
	uv run pytest --cov --cov-report=term-missing --cov-report=xml

# --- Alembic migrations ------------------------------------------------------
migrate:  ## apply all migrations to $DATABASE_URL
	uv run alembic upgrade head

migration-new:  ## create a new autogenerated migration; usage: make migration-new msg="add x"
	@test -n "$(msg)" || (echo "Usage: make migration-new msg=\"description\""; exit 1)
	uv run alembic revision --autogenerate -m "$(msg)"

revision-check:  ## verify migrations linear (no branches)
	uv run alembic heads | wc -l | grep -q 1 || (echo "multiple heads!"; exit 1)

# --- Runtime -----------------------------------------------------------------
api:  ## run the FastAPI server (local dev)
	uv run uvicorn realty_lead_gen.main:app --reload --host 0.0.0.0 --port 8000

worker:  ## run the arq background worker (local dev)
	uv run arq realty_lead_gen.worker.WorkerSettings

shell:  ## drop into a python shell with app context loaded
	uv run python -c "from realty_lead_gen.db import async_session; import asyncio; import IPython; IPython.embed()"

# --- Docker ------------------------------------------------------------------
dev-up:  ## start postgres + redis for local development
	docker compose -f docker-compose.yml --profile dev up -d

dev-down:  ## stop local dev services
	docker compose -f docker-compose.yml --profile dev down

docker-build:  ## build the runtime docker image
	docker build -f docker/Dockerfile -t realty-lead-gen:local .

# --- Housekeeping ------------------------------------------------------------
clean:  ## remove build artifacts and caches
	rm -rf .pytest_cache .mypy_cache .ruff_cache htmlcov .coverage coverage.xml dist build
	rm -f .coverage.*
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
